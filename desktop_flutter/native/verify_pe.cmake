function(neko_verify_pe64 binary expected_machine)
  if(NOT EXISTS "${binary}" OR IS_DIRECTORY "${binary}")
    message(FATAL_ERROR "Missing native binary: ${binary}")
  endif()
  file(SIZE "${binary}" binary_size)
  if(binary_size LESS 64)
    message(FATAL_ERROR "Truncated native binary: ${binary}")
  endif()
  file(READ "${binary}" header OFFSET 0 LIMIT 64 HEX)
  string(SUBSTRING "${header}" 0 4 magic)
  if(NOT magic STREQUAL "4d5a")
    message(FATAL_ERROR "Expected a Windows PE binary: ${binary}")
  endif()
  set(offset_hex "")
  foreach(position 126 124 122 120)
    string(SUBSTRING "${header}" ${position} 2 byte)
    string(APPEND offset_hex "${byte}")
  endforeach()
  math(EXPR offset "0x${offset_hex}")
  math(EXPR minimum_size "${offset} + 26")
  if(offset LESS 64 OR offset GREATER 16777216 OR binary_size LESS minimum_size)
    message(FATAL_ERROR "Invalid PE header offset: ${binary}")
  endif()
  file(READ "${binary}" pe OFFSET ${offset} LIMIT 26 HEX)
  string(SUBSTRING "${pe}" 0 8 signature)
  string(SUBSTRING "${pe}" 8 4 machine)
  string(SUBSTRING "${pe}" 48 4 optional_magic)
  if(NOT signature STREQUAL "50450000" OR NOT machine STREQUAL "${expected_machine}" OR NOT optional_magic STREQUAL "0b02")
    message(FATAL_ERROR "Wrong architecture or invalid PE32+ binary: ${binary}")
  endif()
endfunction()

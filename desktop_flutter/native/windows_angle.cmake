set(NEKO_WINDOWS_ANGLE_DIR "$ENV{NEKO_WINDOWS_ANGLE_DIR}" CACHE PATH "Native ANGLE runtime, headers and import libraries")
if(FLUTTER_TARGET_PLATFORM STREQUAL "windows-arm64" AND NOT NEKO_WINDOWS_ANGLE_DIR)
  set(NEKO_WINDOWS_ARM64_ANGLE_DIR "$ENV{NEKO_WINDOWS_ARM64_ANGLE_DIR}" CACHE PATH "ARM64 ANGLE runtime, headers and import libraries")
  set(NEKO_WINDOWS_ANGLE_DIR "${NEKO_WINDOWS_ARM64_ANGLE_DIR}")
  if(NOT IS_DIRECTORY "${NEKO_WINDOWS_ANGLE_DIR}")
    message(FATAL_ERROR "Windows ARM64 requires NEKO_WINDOWS_ARM64_ANGLE_DIR with native ARM64 ANGLE. The upstream media_kit ANGLE archive is x64 and must not be used on ARM64.")
  endif()
endif()
if(NEKO_WINDOWS_ANGLE_DIR)
  if(FLUTTER_TARGET_PLATFORM STREQUAL "windows-arm64")
    set(angle_machine "64aa")
  elseif(FLUTTER_TARGET_PLATFORM STREQUAL "windows-x64")
    set(angle_machine "6486")
  else()
    message(FATAL_ERROR "Unsupported ANGLE target: ${FLUTTER_TARGET_PLATFORM}")
  endif()
  get_filename_component(angle_root "${NEKO_WINDOWS_ANGLE_DIR}" REALPATH)
  get_filename_component(angle_staging "${CMAKE_BINARY_DIR}/ANGLE" ABSOLUTE)
  string(FIND "${angle_root}/" "${angle_staging}/" staging_prefix)
  if(staging_prefix EQUAL 0)
    message(FATAL_ERROR "ANGLE input must be outside the generated build/ANGLE directory.")
  endif()
  foreach(required "include/EGL/egl.h" "include/GLES2/gl2.h" "lib/libEGL.dll.lib" "lib/libGLESv2.dll.lib" "libEGL.dll" "libGLESv2.dll")
    if(NOT EXISTS "${angle_root}/${required}")
      message(FATAL_ERROR "Missing ANGLE component: ${angle_root}/${required}")
    endif()
  endforeach()
  include("${CMAKE_CURRENT_LIST_DIR}/verify_pe.cmake")
  file(GLOB NEKO_ANGLE_LIBRARIES "${angle_root}/*.dll")
  foreach(binary IN LISTS NEKO_ANGLE_LIBRARIES)
    neko_verify_pe64("${binary}" "${angle_machine}")
  endforeach()
  file(REMOVE_RECURSE "${angle_staging}")
  file(MAKE_DIRECTORY "${angle_staging}")
  file(COPY "${angle_root}/include" "${angle_root}/lib" ${NEKO_ANGLE_LIBRARIES} DESTINATION "${angle_staging}")
  if(EXISTS "${angle_root}/LICENSE")
    install(FILES "${angle_root}/LICENSE" DESTINATION "${CMAKE_INSTALL_PREFIX}/licenses/angle" COMPONENT Runtime)
  endif()
endif()
